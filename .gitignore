# Build artifacts
dist/
build/
*.egg-info/

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db


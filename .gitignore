#
#

# Ignore all files and folders inside volume
volume/**

# Allow subfolders
!volume/**/

# Ignore subfolders content except .gitkeep
!volume/**/.gitkeep
#

# Ignore samples at system

system/samples/
system/sounds/**/*.wav
*.bak

# Local agent session artifacts
.superpowers/

# Copy to .env.local, or .env.prod.local when using --env prod.
# All settings below are supported. The service always starts disarmed.
# Complete hardware verification before enabling unattended alarms.
DEBUG=1

LOG_LEVEL=INFO

STORAGE_FOLDER=volume

#
# Camera: enter raw credentials; config will assemble the RTSP URL.
RTSP_LOGIN=admin
RTSP_PASSWORD=
RTSP_HOST=
RTSP_PORT=554
RTSP_PATH=/ch1/main
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=2000

#
# Telegram: comma-separated numeric user IDs; empty means deny all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CHAT_ID=

#
# Detection: paths are relative to the project root; durations are seconds.
DETECTION_MODEL_PATH=system/models/person.onnx
DETECTION_CONFIDENCE=0.35
DETECTION_DAY_CONFIRM_SECONDS=2
DETECTION_NIGHT_CONFIRM_SECONDS=3
DETECTION_ABSENCE_SECONDS=2
DETECTION_MAX_FRAME_AGE_SECONDS=2
DETECTION_ON_ALARM_SEND_PHOTO_EVERY_MS=0
DETECTION_TIMEZONE=Europe/Prague
DETECTION_NIGHT_START=22:00
DETECTION_NIGHT_END=06:00

#
# Audio: AUDIO_DEVICE selects local speaker output on the Raspberry Pi.
AUDIO_SOUNDS_FOLDER=system/sounds
# cz and en are defaults; create a sound subfolder and configure its name for any language.
AUDIO_MAIN_LANGUAGE=cz
# AUDIO_LANGUAGES=cz
AUDIO_LANGUAGES=en,cz
AUDIO_SEQUENCE=first_warning,countdown_1,countdown_2,countdown_3,alarm
AUDIO_DEVICE=default
AUDIO_VOLUME=
AUDIO_MAX_ALARM_SECONDS=60
AUDIO_MAX_ALARM_CYCLES=3
